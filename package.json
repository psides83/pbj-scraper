{
  "name": "pbj-scraper",
  "version": "1.0.0",
  "description": "Starter Playwright scraper for PBJ",
  "main": "scrape.mjs",
  "scripts": {
    "scrape": "PLAYWRIGHT_BROWSERS_PATH=/tmp/pw-browsers node scrape.mjs",
    "scrape:batched": "PLAYWRIGHT_BROWSERS_PATH=/tmp/pw-browsers node scrape-batched.mjs",
    "update:data": "PLAYWRIGHT_BROWSERS_PATH=/tmp/pw-browsers node update-data.mjs",
    "install:browsers": "PLAYWRIGHT_BROWSERS_PATH=/tmp/pw-browsers node ./node_modules/playwright/cli.js install chromium"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "playwright": "^1.59.1"
  }
}
